<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:UI"
        Icon="app.ico"
        Title="Auto Affection Skip" Height="500" Width="360" MinHeight="500" MinWidth="360"
        Background="#F3F7F8">

    <Window.Resources>
        <!-- 포인트 컬러 설정 -->
        <SolidColorBrush x:Key="Pink" Color="#fd8ca0"/>
        <SolidColorBrush x:Key="DarkPink" Color="#e87a8e"/>

        <!-- 버튼 스타일 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Pink}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DarkPink}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#cccccc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 설정/홈(아이콘) 버튼 스타일: 현재 화면을 알 수 있도록 비활성화 시 흐리게 표시 -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 리스트박스 -->
        <Style x:Key="ChatListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- 메인 화면: MainScreenViewModel이 CurrentViewModel일 때 자동으로 선택됨 (pure MVVM) -->
        <DataTemplate DataType="{x:Type local:MainScreenViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 로그 출력 부분 -->
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Logs}"
                         Style="{StaticResource ChatListBoxStyle}"
                         Margin="10"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         local:ListBoxBehavior.AutoScrollToEnd="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <!-- 프로필 아이콘 -->
                                <Ellipse Width="35" Height="35" Fill="#ffd1dc" VerticalAlignment="Top" Margin="0,0,8,0"/>

                                <!-- 말풍선 -->
                                <Border Background="White" CornerRadius="0,15,15,15" Padding="12,8" MaxWidth="220">
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="#444444"
                                               FontSize="12"
                                               FontFamily="Malgun Gothic"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <!-- 아이템 선택 시 파란 배경 제거 -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 하단 컨트롤 영역 -->
                <Border Grid.Row="1" Background="White" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <UniformGrid Columns="2" Height="45">
                        <Button Content="시작"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsStartEnabled}"
                                Margin="0,0,5,0"/>

                        <Button Content="종료"
                                Command="{Binding StopCommand}"
                                Background="#A0A0A0"
                                Margin="5,0,0,0"/>
                    </UniformGrid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 설정 화면: SettingsScreenViewModel이 CurrentViewModel일 때 자동으로 선택됨 (pure MVVM) -->
        <DataTemplate DataType="{x:Type local:SettingsScreenViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Margin="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                 ui:ControlHelper.Header="임계값 (일반)"
                                 ui:ControlHelper.Description="일반 이미지 인식 정확도 (0.0 ~ 1.0, 기본 0.95)"/>

                        <TextBox Text="{Binding ThresholdStrictText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,16,0,0"
                                 ui:ControlHelper.Header="임계값 (엄격)"
                                 ui:ControlHelper.Description="오탐 방지용 정확도 (0.0 ~ 1.0, 기본 0.99)"/>

                        <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,16,0,0"
                                 ui:ControlHelper.Header="지연 시간 (ms)"
                                 ui:ControlHelper.Description="매크로 루프 사이의 대기 시간 (기본 1000ms)"/>

                        <TextBox Text="{Binding RetryCountText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,16,0,0"
                                 ui:ControlHelper.Header="응답 대기 재시도 횟수"
                                 ui:ControlHelper.Description="메시지 응답을 기다리는 최대 횟수 (기본 5회)"/>

                        <ComboBox SelectedIndex="{Binding SelectedCaptureOption}"
                                  Margin="0,16,0,0"
                                  HorizontalAlignment="Stretch"
                                  ui:ControlHelper.Header="화면 캡처 방식"
                                  ui:ControlHelper.Description="화면이 검게 캡처되는 등 문제가 있을 때 전환해보세요">
                            <ComboBoxItem Content="BitBlt (기본)"/>
                            <ComboBoxItem Content="PrintWindow"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                    <Button Content="저장" Width="90" Height="32" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                    <Button Content="취소" Width="90" Height="32" Background="#A0A0A0" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 상단 헤더 -->
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 바 -->
        <Border Grid.Row="0" Background="{StaticResource Pink}">
            <Grid Height="45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding NavigateToMainCommand}"
                        IsEnabled="{Binding IsHomeNavEnabled}"
                        ToolTip="홈"
                        Margin="10,0,0,0">
                    <ui:FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding NavigateToSettingsCommand}"
                        IsEnabled="{Binding IsSettingsNavEnabled}"
                        ToolTip="설정"
                        Margin="0,0,10,0">
                    <ui:FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- 현재 화면: CurrentViewModel의 실제 타입에 맞는 DataTemplate이 자동으로 적용됨 -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
