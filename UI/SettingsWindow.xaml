<Window x:Class="UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="560" Width="340" MinHeight="300" MinWidth="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F3F7F8">

    <Window.Resources>
        <SolidColorBrush x:Key="Pink" Color="#fd8ca0"/>
        <SolidColorBrush x:Key="DarkPink" Color="#e87a8e"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Pink}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DarkPink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#444444"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Label Content="임계값 (일반)"/>
            <TextBox x:Name="ThresholdTextBox"/>
            <TextBlock Text="일반 이미지 인식 정확도 (0.0 ~ 1.0, 기본 0.95)" Style="{StaticResource HintText}"/>

            <Label Content="임계값 (엄격)" Margin="0,12,0,0"/>
            <TextBox x:Name="ThresholdStrictTextBox"/>
            <TextBlock Text="단순한 이미지용 정확도, 오탐 방지 (0.0 ~ 1.0, 기본 0.99)" Style="{StaticResource HintText}"/>

            <Label Content="지연 시간 (ms)" Margin="0,12,0,0"/>
            <TextBox x:Name="DelayTextBox"/>
            <TextBlock Text="매크로 루프 사이의 대기 시간 (기본 1000ms)" Style="{StaticResource HintText}"/>

            <Label Content="응답 대기 재시도 횟수" Margin="0,12,0,0"/>
            <TextBox x:Name="RetryCountTextBox"/>
            <TextBlock Text="메시지 응답을 기다리는 최대 횟수 (기본 5회)" Style="{StaticResource HintText}"/>

            <Label Content="화면 캡처 방식" Margin="0,12,0,0"/>
            <ComboBox x:Name="CaptureOptionComboBox">
                <ComboBoxItem Content="BitBlt (기본)"/>
                <ComboBoxItem Content="PrintWindow"/>
            </ComboBox>
            <TextBlock Text="화면이 검게 캡처되는 등 문제가 있을 때 전환해보세요" Style="{StaticResource HintText}"/>
        </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="1" Columns="2" Height="45" Margin="0,15,0,0">
            <Button Content="저장" Click="SaveButton_Click" Margin="0,0,5,0"/>
            <Button Content="취소" Background="#A0A0A0" Click="CancelButton_Click" Margin="5,0,0,0"/>
        </UniformGrid>
    </Grid>
</Window>
